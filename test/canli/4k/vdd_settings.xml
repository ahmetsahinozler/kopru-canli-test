<?xml version='1.0' encoding='utf-8'?>
<!-- Virtual Display Driver (VirtualDrivers/Virtual-Display-Driver, MIT) ayarı:
     tek sanal monitör, kullanıcının kurulumu gibi 3840×2160; kalibrasyon ve yerel
     aşamalarının çözünürlük değiştirme denemeleri için 1920×1080 ve 2560×1440 de var.
     ekran-4k.ps1 bunu C:\VirtualDisplayDriver\vdd_settings.xml olarak yazar. -->
<vdd_settings>
    <monitors>
        <count>1</count>
    </monitors>
    <gpu>
        <friendlyname>default</friendlyname>
    </gpu>
    <global>
        <g_refresh_rate>60</g_refresh_rate>
    </global>
    <resolutions>
        <resolution>
            <width>1920</width>
            <height>1080</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>2560</width>
            <height>1440</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>3840</width>
            <height>2160</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
    </resolutions>
    <options>
        <CustomEdid>false</CustomEdid>
        <PreventSpoof>false</PreventSpoof>
        <EdidCeaOverride>false</EdidCeaOverride>
        <HardwareCursor>true</HardwareCursor>
        <SDR10bit>false</SDR10bit>
        <HDRPlus>false</HDRPlus>
        <logging>true</logging>
        <debuglogging>false</debuglogging>
    </options>
</vdd_settings>
